# Configurações do Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=false # Defina como true em produção caso esteja atrás de proxy reverso (Nginx, Cloudflare)

# Banco de Dados PostgreSQL (utilize DATABASE_URL OU os campos individuais abaixo)
# Exemplo em nuvem: postgresql://usuario:senha@host:5432/banco?sslmode=require
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sistema_financeiro
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true # Mantenha true por padrão; defina como false apenas se o provedor nuvem usar certificado auto-assinado

# Autenticação JWT
JWT_SECRET=seu_segredo_jwt_aqui_substitua_em_producao

# Rotina Agendada (Cron diário)
# Chave secreta obrigatória para proteger o endpoint de acionamento do cron (/api/cron/daily-alerts)
CRON_SECRET=seu_segredo_cron_aqui_minimo_32_caracteres
CRON_TIMEOUT_MS=30000

# Serviço de E-mail (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu_usuario_smtp
SMTP_PASS=sua_senha_smtp
SMTP_FROM=nao-responda@sistemafinanceiro.com
