# ==============================================================================
# .gitignore — Sistema de Controle Financeiro Pessoal
# ==============================================================================

# 1. Dependências do Node.js
# As dependências podem ser restauradas executando 'npm install' em cada módulo
node_modules/
*/node_modules/

# 2. Variáveis de Ambiente e Credenciais Sensíveis (Segurança e Segredos)
# NUNCA versionar senhas, chaves de API, JWT_SECRET ou credenciais reais de banco
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# 3. Certificados, Chaves Criptográficas e Tokens
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# 4. Logs de Execução e Erro
# O diretório backend/logs é preservado via .gitkeep, mas seu conteúdo de log é ignorado
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/logs/*
!backend/logs/.gitkeep

# 5. Diretórios de Build e Artefatos Compilados
# Gerados automaticamente pelo processo de build do Vite
dist/
dist-ssr/
build/
*/dist/
*/build/
.vite/

# 6. Dados Locais de Banco e Dumps
*.sql.gz
*.dump
*.tar
pgdata/
.postgres-data/
docker-data/

# 7. Arquivos Temporários, Caches e Cobertura de Testes
.temp/
.tmp/
tmp/
.cache/
.eslintcache
coverage/
*.lcov

# 8. Arquivos do Sistema Operacional e Editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.user
*.swp
*~
