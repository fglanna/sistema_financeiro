# ==============================================================================
# .gitattributes — Sistema de Controle Financeiro Pessoal
# ==============================================================================

# Normalização automática de quebras de linha (Line Endings) para LF
* text=auto eol=lf

# Arquivos de Código-fonte (JavaScript, React JSX, CSS, HTML)
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf

# Arquivos de Documentação e Configuração
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
.env.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Arquivos de Mídia e Imagens Binárias
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.pdf binary
